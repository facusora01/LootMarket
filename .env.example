# Copiá este archivo a .env (en la raíz) y completá los valores.
# .env está en .gitignore: los secretos NUNCA se commitean (ISO 27001 A.5.17 / A.8.9).
# Lo lee docker-compose para inicializar Postgres.

# Password del superusuario postgres del contenedor.
POSTGRES_PASSWORD=

# Password del rol de mínimo privilegio de la API (lootmarket_app).
# Lo usa db/init/00_roles.sh para crear el rol. DEBE coincidir con PGPASSWORD de server/.env.
APP_DB_PASSWORD=

# Generar passwords al azar, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
