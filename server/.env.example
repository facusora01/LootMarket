# Copia este archivo a server/.env y completá los valores.
# server/.env está en .gitignore: los secretos NUNCA se commitean (ISO 27001 A.5.17 / A.8.24).

# Clave simétrica para el cifrado en reposo de los datos de pago (pgp_sym_encrypt).
# OBLIGATORIA: la API no arranca sin ella. En producción usar KMS/Vault, no un .env.
# Generar una al azar, p.ej.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_KEY=

# Conexión a la base (rol de mínimo privilegio, TP6).
# PGPASSWORD es OBLIGATORIA y DEBE coincidir con APP_DB_PASSWORD del .env raíz.
PGHOST=localhost
PGPORT=5432
PGDATABASE=lootmarket
PGUSER=lootmarket_app
PGPASSWORD=

# Origen permitido por CORS (A.8.20/A.8.23). Coma-separado para múltiples.
CORS_ORIGIN=http://localhost:5173

# Puerto de la API.
PORT=3001
